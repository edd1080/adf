{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adf.dev/schemas/manifest.schema.json",
  "title": "ADF Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "framework", "specKit", "managedFiles", "skills"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "installedAt"],
      "properties": {
        "name": { "const": "adf" },
        "version": { "type": "string", "minLength": 1 },
        "installedAt": { "type": "string", "format": "date-time" }
      }
    },
    "specKit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "defaultIntegration", "installedIntegrations"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "defaultIntegration": { "enum": ["codex", "opencode"] },
        "installedIntegrations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["codex", "opencode"] }
        }
      }
    },
    "managedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "strategy", "installedSha256"],
        "properties": {
          "path": { "$ref": "#/$defs/safeRelativePath" },
          "strategy": {
            "enum": ["replace-if-unmodified", "merge-markers", "merge-json", "preserve"]
          },
          "installedSha256": { "$ref": "#/$defs/sha256" },
          "scope": { "enum": ["file", "managed-block"] }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "version", "sha256"],
            "properties": {
              "kind": { "const": "adf" },
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "name",
              "source",
              "upstreamCommit",
              "license",
              "originalSha256",
              "adaptedSha256",
              "adaptation"
            ],
            "properties": {
              "kind": { "const": "vendored" },
              "name": { "type": "string", "minLength": 1 },
              "source": { "type": "string", "format": "uri" },
              "upstreamCommit": { "type": "string", "minLength": 7 },
              "license": { "const": "MIT" },
              "originalSha256": { "$ref": "#/$defs/sha256" },
              "adaptedSha256": { "$ref": "#/$defs/sha256" },
              "adaptation": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    }
  }
}
